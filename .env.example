# Copy to .env on the VPS and fill in real values:
#   cp .env.example .env

# SQLite database (keep inside project; path is relative to repo root)
DATABASE_URL="file:./prisma/prod.db"

NODE_ENV="production"

# App port — must match PM2 and Nginx upstream (isolated from other projects)
PORT=3005

# NextAuth — REQUIRED for production login sessions
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://sales-arena.duckdns.org"

# Optional: legacy CSV/Excel import script (scripts/import-legacy-data.ts)
# IMPORT_DEFAULT_PASSWORD="change-me-after-import"
# IMPORT_EMAIL_DOMAIN="imported.newjerseyegypt.com"
