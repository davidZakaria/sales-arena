generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  SALES
  MANAGER
  DIRECTOR
  OPERATIONS
  FINANCE
}

enum AgencyStatus {
  DRAFT
  OPEN_RACE
  ASSIGNED
  PENDING_AUDIT
  VERIFIED
  ARCHIVED
}

enum ContractStatus {
  PENDING
  SIGNED
  MISSING
}

enum AssignmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ComplianceDocumentType {
  CONTRACT
  TAX_ID
  COMMERCIAL_REGISTER
  OTHER
}

enum EOIStatus {
  PENDING_FINANCE
  VERIFIED
  REJECTED
  CONVERTED
}

enum InboundSource {
  OPERATIONS
  PUBLIC_PORTAL
  WHATSAPP
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  managerId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  manager              User?                @relation("UserHierarchy", fields: [managerId], references: [id])
  reports              User[]               @relation("UserHierarchy")
  primaryAgencies      Agency[]             @relation("PrimaryOwner")
  sharedAgencies       Agency[]             @relation("AgencyCoOwners")
  createdAgencies      Agency[]             @relation("AgencyCreator")
  auditLogs            AuditLog[]
  assignmentRequests   AssignmentRequest[]
  complianceDocuments  ComplianceDocument[]
  eois                 EOI[]

  @@index([managerId])
  @@index([role])
}

model Agency {
  id                  String         @id @default(cuid())
  name                String
  type                String?
  commercialRegister  String?
  taxId               String?
  whatsappLink        String?
  location            String?
  repPhone1           String?
  status              AgencyStatus
  primaryOwnerId      String?
  createdById         String?
  source              InboundSource  @default(OPERATIONS)
  inboundNotes        String?
  contractStatus      ContractStatus
  isDisputed          Boolean        @default(false)
  claimedAt           DateTime?
  claimExpiresAt      DateTime?
  submittedForAuditAt DateTime?
  brokerInviteToken   String         @unique @default(cuid())
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  primaryOwner        User?                @relation("PrimaryOwner", fields: [primaryOwnerId], references: [id])
  createdBy           User?                @relation("AgencyCreator", fields: [createdById], references: [id])
  coOwners            User[]               @relation("AgencyCoOwners")
  auditLogs           AuditLog[]
  assignmentRequests  AssignmentRequest[]
  complianceDocuments ComplianceDocument[]
  eois                EOI[]
  brokerContacts      BrokerContact[]

  @@index([status])
  @@index([primaryOwnerId])
  @@index([createdById])
  @@index([source])
  @@index([contractStatus])
  @@index([claimExpiresAt])
  @@index([isDisputed])
  @@index([submittedForAuditAt])
  @@index([whatsappLink])
  @@index([repPhone1])
}

model EOI {
  id              String    @id @default(cuid())
  agencyId        String
  userId          String
  brokerContactId String?
  clientName      String
  project         String
  amount          Float
  paymentMethod   String
  receiptUrl      String?
  status          EOIStatus @default(PENDING_FINANCE)
  financeNotes    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  agency        Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id])
  brokerContact BrokerContact? @relation(fields: [brokerContactId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([agencyId])
  @@index([userId])
  @@index([brokerContactId])
  @@index([createdAt])
}

model BrokerContact {
  id        String   @id @default(cuid())
  agencyId  String
  name      String
  phone     String
  role      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  eois   EOI[]

  @@index([agencyId])
  @@index([phone])
}

model AssignmentRequest {
  id        String                  @id @default(cuid())
  agencyId  String
  userId    String
  status    AssignmentRequestStatus @default(PENDING)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([agencyId])
  @@index([userId])
  @@index([agencyId, userId])
}

model ComplianceDocument {
  id           String                 @id @default(cuid())
  agencyId     String
  uploadedById String
  fileName     String
  documentType ComplianceDocumentType
  createdAt    DateTime               @default(now())

  agency     Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation(fields: [uploadedById], references: [id])

  @@index([agencyId])
  @@index([uploadedById])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  agencyId  String
  userId    String
  action    String
  createdAt DateTime @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([agencyId])
  @@index([userId])
  @@index([createdAt])
}
